<!-- Overlay for mobile -->
<div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 hidden lg:hidden" onclick="closeSidebar()"></div>

<!-- Sidebar -->
<div
  id="adminSidebar"
  class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-white shadow-lg transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col"
>
  <div class="p-4 border-b flex items-center justify-between">
    <div class="text-gray-600 text-sm font-semibold">Admin Panel</div>
    <!-- Close button visible only on mobile -->
    <button class="lg:hidden text-gray-500 hover:text-gray-700 focus:outline-none" onclick="closeSidebar()">
      <i class="fas fa-times text-lg"></i>
    </button>
  </div>

  <nav class="p-4 space-y-1 flex-1 overflow-y-auto">
    <a
      href="/admin/dashboard"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/dashboard' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-th-large"></i>
      <span>Dashboard</span>
    </a>

    <a
      href="/admin/category"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/category' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-tags"></i>
      <span>Category</span>
    </a>

    <a
      href="/admin/brand"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/brand' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-cube"></i>
      <span>Brands</span>
    </a>

    <a
      href="/admin/product"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/product' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-box"></i>
      <span>Products</span>
    </a>

    <a
      href="/admin/users"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/users' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-users"></i>
      <span>Customers</span>
    </a>

    <a
      href="/admin/adminOrders"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/adminOrders' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-shopping-cart"></i>
      <span>Orders</span>
    </a>

    <a
      href="/admin/coupon"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/coupon' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-ticket-alt"></i>
      <span>Coupons</span>
    </a>

    <a
      href="/admin/banner"
      class="flex items-center gap-3 px-4 py-2 <%= currentRoute === '/admin/banner' ? 'bg-blue-50 text-blue-700 border-r-4 border-blue-600' : 'text-gray-700 hover:bg-gray-100' %> rounded"
    >
      <i class="fas fa-image"></i>
      <span>Banners</span>
    </a>

    <a
      href="/admin/logout"
      class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-100 rounded"
    >
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    </a>
  </nav>
</div>

<script>
  function openSidebar() {
    const sidebar = document.getElementById('adminSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    if (sidebar) sidebar.classList.remove('-translate-x-full');
    if (overlay) overlay.classList.remove('hidden');
  }
  function closeSidebar() {
    const sidebar = document.getElementById('adminSidebar');
    const overlay = document.getElementById('sidebarOverlay');
    if (sidebar) sidebar.classList.add('-translate-x-full');
    if (overlay) overlay.classList.add('hidden');
  }
</script>
