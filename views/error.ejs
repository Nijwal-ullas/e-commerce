<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page Not Found | Ruhe Collection</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#6D28D9"
          }
        }
      }
    }
  </script>
</head>

<body class="bg-gray-50 min-h-screen flex items-center justify-center">

  <div class="bg-white rounded-xl shadow-sm p-10 text-center max-w-md w-full">

    <h1 class="text-6xl font-extrabold text-primary mb-4">404</h1>

    <h2 class="text-2xl font-semibold text-gray-800 mb-2">
      Oops! Page not found
    </h2>

    <p class="text-gray-500 mb-8">
      The page you are looking for doesn’t exist or has been moved.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/"
        class="bg-primary text-white px-6 py-2.5 rounded-lg hover:bg-purple-700 transition"
      >
        Go to Home
      </a>

      <a
        href="/product"
        class="border border-primary text-primary px-6 py-2.5 rounded-lg hover:bg-purple-50 transition"
      >
        Browse Products
      </a>
    </div>

  </div>

</body>
</html>
