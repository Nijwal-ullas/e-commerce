<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Banner Management - Wasm Collection</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  </head>

  <body class="bg-gray-100">
    <div class="flex h-screen">
      <%- include('../partials/admin/sidebar') %>

      <main class="flex-1 overflow-y-auto">
        <%- include('../partials/admin/header') %>

        <div class="p-6">
          <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-semibold text-gray-800">Banner Management</h1>
            <button
              onclick="openAddModal()"
              class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 flex items-center gap-2"
            >
              <i class="fas fa-plus"></i> Add Banner
            </button>
          </div>

          <% if (banners.length === 0) { %>
          <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">
            <i class="fas fa-image text-5xl mb-4 text-gray-300"></i>
            <p class="text-lg">No banners found. Add your first banner!</p>
          </div>
          <% } else { %>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <% banners.forEach(banner => { %>
            <div class="bg-white rounded-lg shadow overflow-hidden" id="banner-<%= banner._id %>">
              <div class="relative h-48 bg-gray-200">
                <img
                  src="<%= banner.imageUrl %>"
                  alt="Banner"
                  class="w-full h-full object-cover"
                />
                <span class="absolute top-2 right-2 px-2 py-1 rounded text-xs font-semibold
                  <%= banner.isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                  <%= banner.isActive ? 'Active' : 'Inactive' %>
                </span>
              </div>

              <div class="p-3 flex gap-2">
                <button
                  onclick="openEditModal('<%= banner._id %>', '<%= banner.imageUrl %>')"
                  class="flex-1 bg-yellow-500 text-white py-1.5 rounded hover:bg-yellow-600 text-sm flex items-center justify-center gap-1"
                >
                  <i class="fas fa-edit"></i> Edit
                </button>
                <button
                  onclick="toggleBanner('<%= banner._id %>', <%= banner.isActive %>)"
                  class="flex-1 py-1.5 rounded text-sm flex items-center justify-center gap-1
                    <%= banner.isActive ? 'bg-orange-500 hover:bg-orange-600 text-white' : 'bg-green-500 hover:bg-green-600 text-white' %>"
                >
                  <i class="fas fa-<%= banner.isActive ? 'eye-slash' : 'eye' %>"></i>
                  <%= banner.isActive ? 'Deactivate' : 'Activate' %>
                </button>
                <button
                  onclick="deleteBanner('<%= banner._id %>')"
                  class="bg-red-500 text-white px-3 py-1.5 rounded hover:bg-red-600 text-sm flex items-center justify-center"
                >
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>

        </div>
      </main>
    </div>

    <div id="addModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center p-6 border-b">
          <h2 class="text-xl font-semibold text-gray-800">Add New Banner</h2>
          <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>
        <form id="addBannerForm" class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Banner Image <span class="text-red-500">*</span></label>
            <input type="file" id="addImage" name="image" accept="image/*"
              onchange="previewImage(this, 'addPreview')"
              class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-400" />
            <div id="addPreview" class="mt-2 hidden">
              <img id="addPreviewImg" src="" alt="Preview" class="w-full h-40 object-cover rounded border" />
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="button" onclick="submitAddBanner()"
              class="flex-1 bg-blue-600 text-white py-2 rounded hover:bg-blue-700 font-medium">
              Add Banner
            </button>
            <button type="button" onclick="closeAddModal()"
              class="flex-1 bg-gray-200 text-gray-700 py-2 rounded hover:bg-gray-300 font-medium">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>

    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-lg shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center p-6 border-b">
          <h2 class="text-xl font-semibold text-gray-800">Edit Banner</h2>
          <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>
        <form id="editBannerForm" class="p-6 space-y-4">
          <input type="hidden" id="editBannerId" />
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Replace Image (optional)</label>
            <input type="file" id="editImage" name="image" accept="image/*"
              onchange="previewImage(this, 'editPreview')"
              class="w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-400" />
            <div id="editPreview" class="mt-2">
              <img id="editPreviewImg" src="" alt="Current Banner" class="w-full h-40 object-cover rounded border" />
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="button" onclick="submitEditBanner()"
              class="flex-1 bg-yellow-500 text-white py-2 rounded hover:bg-yellow-600 font-medium">
              Update Banner
            </button>
            <button type="button" onclick="closeEditModal()"
              class="flex-1 bg-gray-200 text-gray-700 py-2 rounded hover:bg-gray-300 font-medium">
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function openAddModal() {
        document.getElementById("addBannerForm").reset();
        document.getElementById("addPreview").classList.add("hidden");
        document.getElementById("addModal").classList.remove("hidden");
      }
      function closeAddModal() {
        document.getElementById("addModal").classList.add("hidden");
      }
      function openEditModal(id, imageUrl) {
        document.getElementById("editBannerId").value = id;
        document.getElementById("editImage").value = "";
        document.getElementById("editPreviewImg").src = imageUrl;
        document.getElementById("editPreview").classList.remove("hidden");
        document.getElementById("editModal").classList.remove("hidden");
      }
      function closeEditModal() {
        document.getElementById("editModal").classList.add("hidden");
      }

      function previewImage(input, previewId) {
        const preview = document.getElementById(previewId);
        const img = document.getElementById(previewId + "Img");
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = (e) => {
            img.src = e.target.result;
            preview.classList.remove("hidden");
          };
          reader.readAsDataURL(input.files[0]);
        }
      }

      function setLoading(btn, isLoading, loadingText, originalHTML) {
        if (isLoading) {
          btn.disabled = true;
          btn.classList.add("opacity-60", "cursor-not-allowed");
          btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i>${loadingText}`;
        } else {
          btn.disabled = false;
          btn.classList.remove("opacity-60", "cursor-not-allowed");
          btn.innerHTML = originalHTML;
        }
      }

      async function submitAddBanner() {
        const imageFile = document.getElementById("addImage").files[0];

        if (!imageFile) return Swal.fire("Error", "Please select a banner image", "error");

        const btn = document.querySelector('#addModal button[onclick="submitAddBanner()"]');
        const originalHTML = btn.innerHTML;
        setLoading(btn, true, "Adding...", originalHTML);

        const formData = new FormData();
        formData.append("image", imageFile);

        try {
          const res = await axios.post("/admin/banner", formData);
          if (res.data.success) {
            await Swal.fire("Success!", res.data.message, "success");
            location.reload();
          }
        } catch (err) {
          Swal.fire("Error", err.response?.data?.message || "Something went wrong", "error");
          setLoading(btn, false, "", originalHTML);
        }
      }

      async function submitEditBanner() {
        const id = document.getElementById("editBannerId").value;
        const imageFile = document.getElementById("editImage").files[0];

        const btn = document.querySelector('#editModal button[onclick="submitEditBanner()"]');
        const originalHTML = btn.innerHTML;
        setLoading(btn, true, "Updating...", originalHTML);

        const formData = new FormData();
        if (imageFile) formData.append("image", imageFile);

        try {
          const res = await axios.put(`/admin/banner/${id}`, formData);
          if (res.data.success) {
            await Swal.fire("Success!", res.data.message, "success");
            location.reload();
          }
        } catch (err) {
          Swal.fire("Error", err.response?.data?.message || "Something went wrong", "error");
          setLoading(btn, false, "", originalHTML);
        }
      }

      async function toggleBanner(id, currentStatus) {
        const action = currentStatus ? "deactivate" : "activate";
        const confirm = await Swal.fire({
          title: `${action.charAt(0).toUpperCase() + action.slice(1)} Banner?`,
          text: `Are you sure you want to ${action} this banner?`,
          icon: "question",
          showCancelButton: true,
          confirmButtonText: "Yes",
          cancelButtonText: "Cancel",
          confirmButtonColor: currentStatus ? "#f97316" : "#22c55e",
        });
        if (!confirm.isConfirmed) return;

        try {
          const res = await axios.patch(`/admin/banner/${id}/toggle`);
          if (res.data.success) {
            await Swal.fire("Done!", res.data.message, "success");
            location.reload();
          }
        } catch (err) {
          Swal.fire("Error", err.response?.data?.message || "Something went wrong", "error");
        }
      }

      async function deleteBanner(id) {
        const confirm = await Swal.fire({
          title: "Delete Banner?",
          text: "This action cannot be undone!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonText: "Delete",
          cancelButtonText: "Cancel",
          confirmButtonColor: "#ef4444",
        });
        if (!confirm.isConfirmed) return;

        try {
          const res = await axios.delete(`/admin/banner/${id}`);
          if (res.data.success) {
            await Swal.fire("Deleted!", res.data.message, "success");
            location.reload();
          }
        } catch (err) {
          Swal.fire("Error", err.response?.data?.message || "Something went wrong", "error");
        }
      }

      document.getElementById("addModal").addEventListener("click", (e) => {
        if (e.target === document.getElementById("addModal")) closeAddModal();
      });
      document.getElementById("editModal").addEventListener("click", (e) => {
        if (e.target === document.getElementById("editModal")) closeEditModal();
      });
    </script>
  </body>
</html>
