<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.productName || 'Product Details' %> - RnBB Collection</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&display=swap');
        .logo { font-family: 'Playfair Display', serif; }
        .out-of-stock-btn { opacity: 0.5; cursor: not-allowed; }
        .variant-btn.active {
            background-color: #1f2937;
            color: white;
            border-color: #1f2937;
        }
    </style>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevatezoom.min.js"></script>
</head>
<body class="bg-white text-gray-800">
    <%- include('../partials/user/header') %>

    <div class="min-h-screen bg-gray-50">
        <div class="bg-white border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-6 md:px-1 py-4">
                <nav class="text-sm">
                    <ol class="flex items-center space-x-2 text-gray-600">
                        <% breadcrumb.forEach((item, index) => { %>
                            <li class="flex items-center">
                                <% if (item.url) { %>
                                    <a href="<%= item.url %>" class="hover:text-blue-600 transition-colors duration-200 flex items-center">
                                        <% if (index === 0) { %>
                                            <i class="fas fa-home mr-2 text-xs"></i>
                                        <% } %>
                                        <%= item.name %>
                                    </a>
                                <% } else { %>
                                    <span class="text-gray-800 font-medium flex items-center">
                                        <% if (index === 0) { %>
                                            <i class="fas fa-home mr-2 text-xs"></i>
                                        <% } %>
                                        <%= item.name %>
                                    </span>
                                <% } %>

                                <% if (index < breadcrumb.length - 1) { %>
                                    <i class="fas fa-chevron-right text-xs text-gray-400 mx-2"></i>
                                <% } %>
                            </li>
                        <% }) %>
                    </ol>
                </nav>
            </div>
        </div>

        <section class="max-w-7xl mx-auto px-6 md:px-12 py-8">
            <div class="grid md:grid-cols-2 gap-12">
                <div>
                    <div class="bg-gray-50 rounded-lg p-8 mb-4 flex items-center justify-center h-96">
                        <img id="mainImage" 
                             src="<%= product.images && product.images[0] ? product.images[0] : 'https://images.unsplash.com/photo-1541643600914-78b084683601?w=400&h=500&fit=crop' %>" 
                             alt="<%= product.productName %>" 
                             class="h-full object-contain">
                    </div>
                    <div class="flex gap-4">
                        <% if (product.images && product.images.length > 0) { %>
                            <% product.images.forEach((image, index) => { %>
                                <% if (index < 4) { %>
                                    <button onclick="changeImage('<%= image %>')" 
                                            class="w-20 h-20 border-2 border-gray-300 rounded overflow-hidden hover:border-gray-800 transition-colors">
                                        <img src="<%= image %>" alt="View <%= index + 1 %>" class="w-full h-full object-cover">
                                    </button>
                                <% } %>
                            <% }) %>
                        <% } else { %>
                            <button onclick="changeImage('https://images.unsplash.com/photo-1541643600914-78b084683601?w=400&h=500&fit=crop')" 
                                    class="w-20 h-20 border-2 border-gray-800 rounded overflow-hidden">
                                <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=400&h=500&fit=crop" alt="View 1" class="w-full h-full object-cover">
                            </button>
                        <% } %>
                    </div>
                </div>

                <div>
                    <h1 class="text-4xl font-bold mb-4"><%= product.productName || 'Product Name' %></h1>

                    <div class="mb-6">
                        <p class="text-sm text-gray-600 mb-1">Offer price</p>
                        <div class="flex items-center gap-3">
                            <p id="price-display" class="text-3xl font-bold text-gray-900">
                                <% if (product.VariantItem && product.VariantItem.length > 0) { %>
                                    <% const firstAvailableVariant = product.VariantItem.find(v => v.Quantity > 0) || product.VariantItem[0]; %>
                                    ₹<%= (firstAvailableVariant.offerPrice || firstAvailableVariant.Price || 0).toFixed(2) %>
                                <% } else { %>
                                    ₹<%= (product.price || 0).toFixed(2) %>
                                <% } %>
                            </p>
                            <div id="original-price-container">
                                <% if (product.VariantItem && product.VariantItem.length > 0) { %>
                                    <% const firstAvailableVariant = product.VariantItem.find(v => v.Quantity > 0) || product.VariantItem[0]; %>
                                    <% if (firstAvailableVariant.Price && firstAvailableVariant.Price > (firstAvailableVariant.offerPrice || 0)) { %>
                                        <p class="text-lg text-gray-500 line-through">₹<%= firstAvailableVariant.Price.toFixed(2) %></p>
                                        <% 
                                            let discountPercentage = 0;
                                            if (firstAvailableVariant.Price && firstAvailableVariant.offerPrice && firstAvailableVariant.Price > 0) {
                                                discountPercentage = Math.round(((firstAvailableVariant.Price - firstAvailableVariant.offerPrice) / firstAvailableVariant.Price) * 100);
                                            }
                                        %>
                                        <% if (discountPercentage > 0) { %>
                                            <span class="bg-red-100 text-red-600 px-2 py-1 rounded text-sm font-medium">
                                                <%= discountPercentage %>% OFF
                                            </span>
                                        <% } %>
                                    <% } %>
                                <% } else if (product.oldPrice && product.oldPrice > (product.price || 0)) { %>
                                    <p class="text-lg text-gray-500 line-through">₹<%= product.oldPrice.toFixed(2) %></p>
                                    <% 
                                        let discountPercentage = 0;
                                        if (product.oldPrice && product.price && product.oldPrice > 0) {
                                            discountPercentage = Math.round(((product.oldPrice - product.price) / product.oldPrice) * 100);
                                        }
                                    %>
                                    <% if (discountPercentage > 0) { %>
                                        <span class="bg-red-100 text-red-600 px-2 py-1 rounded text-sm font-medium">
                                            <%= discountPercentage %>% OFF
                                        </span>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>  
                    </div>
                    
                    <div class="mb-6">
                        <p class="text-sm font-semibold text-gray-700 mb-3">Size (ML):</p>
                        <div class="flex gap-3 flex-wrap" id="variant-container">
                            <% if (product.VariantItem && product.VariantItem.length > 0) { %>
                                <% product.VariantItem.forEach((variant, index) => { %>
                                    <% 
                                        let discountPercentage = 0;
                                        if (variant.Price && variant.offerPrice && variant.Price > 0) {
                                            discountPercentage = Math.round(((variant.Price - variant.offerPrice) / variant.Price) * 100);
                                        }
                                    %>
                                    <button class="variant-btn px-4 py-2 border rounded transition text-sm 
                                        <%= variant.Quantity > 0 ? 'border-gray-300 hover:border-gray-800 hover:bg-gray-800 hover:text-white' : 'border-gray-200 bg-gray-100 text-gray-400 out-of-stock-btn' %>
                                        <%= index === 0 && variant.Quantity > 0 ? 'active border-gray-800 bg-gray-800 text-white' : '' %>"
                                            data-ml="<%= variant.Ml %>"
                                            data-quantity="<%= variant.Quantity %>"
                                            data-offerprice="<%= variant.offerPrice %>"
                                            data-price="<%= variant.Price %>"
                                            data-discount="<%= discountPercentage %>"
                                            <%= variant.Quantity <= 0 ? 'disabled' : '' %>>
                                        <%= variant.Ml %>ml
                                        <% if (variant.Quantity <= 0) { %>
                                            <span class="block text-xs">(Out of Stock)</span>
                                        <% } else if (variant.Quantity < 10) { %>
                                            <span class="block text-xs">(Only <%= variant.Quantity %> left)</span>
                                        <% } %>
                                    </button>
                                <% }) %>
                            <% } else { %>
                                <% 
                                    let discountPercentage = 0;
                                    if (product.oldPrice && product.price && product.oldPrice > 0) {
                                        discountPercentage = Math.round(((product.oldPrice - product.price) / product.oldPrice) * 100);
                                    }
                                %>
                                <button class="variant-btn px-4 py-2 border border-gray-800 bg-gray-800 text-white rounded text-sm active" 
                                        data-ml="50" 
                                        data-quantity="10" 
                                        data-offerprice="<%= product.price || 0 %>" 
                                        data-price="<%= product.oldPrice || 0 %>"
                                        data-discount="<%= discountPercentage %>">
                                    50ml
                                    <% if (discountPercentage > 0) { %>
                                        <span class="block text-xs text-red-600 font-medium"><%= discountPercentage %>% OFF</span>
                                    <% } %>
                                </button>
                                <button class="variant-btn px-4 py-2 border border-gray-300 rounded hover:border-gray-800 hover:bg-gray-800 hover:text-white transition text-sm" 
                                        data-ml="100" 
                                        data-quantity="10" 
                                        data-offerprice="<%= product.price || 0 %>" 
                                        data-price="<%= product.oldPrice || 0 %>"
                                        data-discount="<%= discountPercentage %>">
                                    100ml
                                    <% if (discountPercentage > 0) { %>
                                        <span class="block text-xs text-red-600 font-medium"><%= discountPercentage %>% OFF</span>
                                    <% } %>
                                </button>
                            <% } %>
                        </div>
                        <p id="stock-info" class="text-xs mt-2">
                            <% if (product.VariantItem && product.VariantItem.length > 0) { %>
                                <% const firstAvailableVariant = product.VariantItem.find(v => v.Quantity > 0) || product.VariantItem[0]; %>
                                <% if (firstAvailableVariant.Quantity > 0) { %>
                                    <span class="text-green-600"><%= firstAvailableVariant.Quantity %> pieces in stock</span>
                                <% } else { %>
                                    <span class="text-red-600">Out of Stock</span>
                                <% } %>
                            <% } else { %>
                                <span class="text-green-600">48 pieces in stock</span>
                            <% } %>
                        </p>
                    </div>

                    <div class="mb-6">
                        <p class="text-sm font-semibold text-gray-700 mb-3">Quantity</p>
                        <div class="flex items-center border border-gray-300 rounded w-32">
                            <button onclick="decreaseQty()" class="px-4 py-2 hover:bg-gray-100 transition-colors">-</button>
                            <input type="text" id="quantity" value="1" class="w-12 text-center border-x border-gray-300 focus:outline-none" readonly>
                            <button onclick="increaseQty()" class="px-4 py-2 hover:bg-gray-100 transition-colors">+</button>
                        </div>
                    </div>

                    <div class="space-y-4 mb-6">
                        <button 
                            id="add-to-cart-btn"
                            class="w-full bg-blue-600 text-white py-3 rounded-full font-semibold hover:bg-blue-700 transition flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
                            onclick="addToCart(false)"
                        >
                            🛒 Add to cart
                        </button>
                        
                        <button 
                            id="buy-now-btn"
                            class="w-full bg-green-600 text-white py-3 rounded-full font-semibold hover:bg-green-700 transition flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed"
                            onclick="addToCart(true)"
                        >
                            ⚡ Buy Now
                        </button>
                    </div>

                    <button id="wishlist-btn" 
                            class="flex items-center justify-center w-full text-sm text-gray-700 hover:text-red-500 transition mb-6">
                        <i class="far fa-heart mr-2"></i> ADD TO WISHLIST
                    </button>

                    <div class="border-t border-gray-200 pt-4 mb-6">
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="font-semibold">Brand:</span>
                                <span class="text-gray-600"><%= product.brand?.name || 'N/A' %></span>
                            </div>
                            <div>
                                <span class="font-semibold">Category:</span>
                                <span class="text-gray-600"><%= product.category?.name || 'N/A' %></span>
                            </div>
                            <div>
                                <span class="font-semibold">Status:</span>
                                <span id="overall-status" class="text-green-600">
                                    <% if (product.VariantItem && product.VariantItem.some(v => v.Quantity > 0)) { %>
                                        In Stock
                                    <% } else { %>
                                        Out of Stock
                                    <% } %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description Section -->
            <div class="mt-16">
                <div class="border-b border-gray-200 mb-6">
                    <h2 class="text-2xl font-bold pb-4">Product Description</h2>
                </div>
                <div class="text-gray-700 leading-relaxed space-y-4">
                    <%= product.description || 'No description available.' %>
                </div>
            </div>

            <% if (relatedProducts && relatedProducts.length > 0) { %>
                <div class="mt-16">
                    <h2 class="text-2xl font-bold text-center mb-8">Related Products</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <% relatedProducts.slice(0, 4).forEach(relatedProduct => { %>
                            <% 
                                const relatedFirstVariant = relatedProduct.VariantItem && relatedProduct.VariantItem[0];
                                const relatedOfferPrice = relatedFirstVariant ? (relatedFirstVariant.offerPrice || relatedFirstVariant.Price || 0) : 0;
                                const relatedOriginalPrice = relatedFirstVariant ? (relatedFirstVariant.Price || 0) : 0;
                                const hasDiscount = relatedOriginalPrice > 0 && relatedOriginalPrice > relatedOfferPrice;
                            %>
                            <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-all duration-300 product-card group">
                                <a href="/product/<%= relatedProduct._id %>" class="block">
                                    <div class="relative h-64 bg-gray-50 flex items-center justify-center overflow-hidden rounded-t-lg">
                                        <img src="<%= relatedProduct.images && relatedProduct.images[0] ? relatedProduct.images[0] : 'https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?w=300&h=400&fit=crop' %>" 
                                             alt="<%= relatedProduct.productName %>" 
                                             class="h-full w-full object-contain group-hover:scale-105 transition duration-300">
                                        
                                        <% if (hasDiscount) { %>
                                          <%
                                            let discountPercentage = 0;
                                            if (relatedOriginalPrice > 0 && relatedOfferPrice > 0) {
                                                discountPercentage = Math.round(((relatedOriginalPrice - relatedOfferPrice) / relatedOriginalPrice) * 100);
                                            }
                                          %>
                                          <% if (discountPercentage > 0) { %>
                                            <span class="absolute top-2 left-2 bg-red-100 text-red-600 px-2 py-1 rounded text-sm font-medium">
                                               <%= discountPercentage %>% OFF
                                            </span>
                                          <% } %>
                                        <% } %>
                                        
                                        <% const isInStock = relatedProduct.VariantItem && relatedProduct.VariantItem.some(v => v.Quantity > 0); %>
                                        <% if (!isInStock) { %>
                                            <div class="absolute top-2 right-2 bg-gray-800 text-white px-2 py-1 rounded text-xs font-medium">
                                                Out of Stock
                                            </div>
                                        <% } %>
                                    </div>
                                    
                                    <div class="p-4">
                                        <h3 class="text-sm font-semibold text-gray-800 mb-2 line-clamp-2 hover:text-red-600 transition-colors">
                                            <%= relatedProduct.productName %>
                                        </h3>
                                        
                                        <div class="flex items-center gap-2 mb-2">
                                            <p class="text-red-600 font-bold text-lg">₹<%= relatedOfferPrice.toFixed(2) %></p>
                                            <% if (hasDiscount) { %>
                                                <p class="text-gray-500 line-through text-sm">₹<%= relatedOriginalPrice.toFixed(2) %></p>
                                            <% } %>
                                        </div>
                                        
                                        <div class="flex justify-between items-center text-xs text-gray-500 mb-2">
                                            <% if (relatedProduct.brand?.name) { %>
                                                <span><%= relatedProduct.brand.name %></span>
                                            <% } %>
                                            <% if (relatedProduct.category?.name) { %>
                                                <span><%= relatedProduct.category.name %></span>
                                            <% } %>
                                        </div>
                                        
                                        <p class="text-xs <%= isInStock ? 'text-green-600' : 'text-red-500' %>">
                                            <i class="fas <%= isInStock ? 'fa-check-circle' : 'fa-times-circle' %> mr-1"></i>
                                            <%= isInStock ? 'In Stock' : 'Out of Stock' %>
                                        </p>
                                    </div>
                                </a>
                                
                                <div class="p-4 border-t">
                                    <button 
                                        class="add-to-cart-related w-full bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 font-medium transition-colors duration-200 text-sm flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed" 
                                        data-product-id="<%= relatedProduct._id %>"
                                        onclick="addRelatedToCart('<%= relatedProduct._id %>')"
                                        <%= !isInStock ? 'disabled style="display: none;"' : '' %>
                                    >
                                        🛒 Add to Cart
                                    </button>
                                    
                                    <% if (!isInStock) { %>
                                        <div class="w-full bg-gray-400 text-white px-4 py-2 rounded-lg font-medium text-sm text-center cursor-not-allowed">
                                            ❌ Out of Stock
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } else if (relatedProducts && relatedProducts.length === 0) { %>
                <div class="mt-16 text-center py-12">
                    <i class="fas fa-search text-4xl text-gray-300 mb-4"></i>
                    <h3 class="text-xl font-semibold text-gray-600 mb-2">No related products found</h3>
                    <p class="text-gray-500">Check back later for more products in this category</p>
                </div>
            <% } %>
        </section>
    </div>

    <%- include('../partials/user/footer') %>

    <script>
        let selectedVariant = null;
        let selectedQuantity = 1;
        const productId = '<%= product._id %>';

        const showAlert = {
            success: (message, timer = 2000) => {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: message,
                    timer: timer,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            },
            error: (message) => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: message,
                    confirmButtonColor: '#dc2626'
                });
            },
            warning: (message) => {
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning!',
                    text: message,
                    confirmButtonColor: '#f59e0b'
                });
            },
            info: (message) => {
                Swal.fire({
                    icon: 'info',
                    title: 'Information',
                    text: message,
                    confirmButtonColor: '#3b82f6'
                });
            },
            loading: (message = 'Processing...') => {
                Swal.fire({
                    title: message,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            },
            close: () => {
                Swal.close();
            },
            confirm: (title, text, confirmText = 'Yes', cancelText = 'Cancel') => {
                return Swal.fire({
                    title: title,
                    text: text,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: confirmText,
                    cancelButtonText: cancelText
                });
            }
        };

        function changeImage(src) {
            $('.zoomContainer').remove(); 
            $("#mainImage").removeData('elevateZoom');
            $('#mainImage').attr('src', src);
            $("#mainImage").elevateZoom({
                zoomType: "lens",
                lensShape: "round",
                lensSize: 200
            });
        }

        function increaseQty() {
            const qtyInput = document.getElementById('quantity');
            const maxStock = selectedVariant ? selectedVariant.quantity : getDefaultStock();
            if (parseInt(qtyInput.value) < maxStock && parseInt(qtyInput.value) < 10) {
                qtyInput.value = parseInt(qtyInput.value) + 1;
                selectedQuantity = parseInt(qtyInput.value);
            } else if (parseInt(qtyInput.value) >= maxStock) {
                showAlert.warning(`Maximum available quantity is ${maxStock}`);
            } else {
                showAlert.warning('Maximum quantity per order is 10');
            }
        }

        function decreaseQty() {
            const qtyInput = document.getElementById('quantity');
            if (parseInt(qtyInput.value) > 1) {
                qtyInput.value = parseInt(qtyInput.value) - 1;
                selectedQuantity = parseInt(qtyInput.value);
            }
        }

        function getDefaultStock() {
            const variantButtons = document.querySelectorAll('.variant-btn');
            for (let btn of variantButtons) {
                if (parseInt(btn.dataset.quantity) > 0) {
                    return parseInt(btn.dataset.quantity);
                }
            }
            return 0;
        }

        function updateAddToCartButton() {
            const addToCartBtn = document.getElementById('add-to-cart-btn');
            const buyNowBtn = document.getElementById('buy-now-btn');
            
            if (!selectedVariant || selectedVariant.quantity <= 0) {
                addToCartBtn.disabled = true;
                buyNowBtn.disabled = true;
                addToCartBtn.classList.add('opacity-50', 'cursor-not-allowed');
                buyNowBtn.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                addToCartBtn.disabled = false;
                buyNowBtn.disabled = false;
                addToCartBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                buyNowBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }

        function updatePriceDisplay(offerPrice, originalPrice, discountPercentage) {
            const priceDisplay = document.getElementById('price-display');
            const originalPriceContainer = document.getElementById('original-price-container');
            
            priceDisplay.innerHTML = `₹${offerPrice.toFixed(2)}`;
            
            if (originalPrice > offerPrice && discountPercentage > 0) {
                originalPriceContainer.innerHTML = `
                    <p class="text-lg text-gray-500 line-through">₹${originalPrice.toFixed(2)}</p>
                    <span class="bg-red-100 text-red-600 px-2 py-1 rounded text-sm font-medium">
                        ${discountPercentage}% OFF
                    </span>
                `;
            } else {
                originalPriceContainer.innerHTML = '';
            }
        }

        function initializeVariantSelection() {
            const variantButtons = document.querySelectorAll('.variant-btn');
            
            variantButtons.forEach((button) => {
                if (parseInt(button.dataset.quantity) > 0 && !selectedVariant) {
                    selectedVariant = {
                        ml: button.dataset.ml,
                        quantity: parseInt(button.dataset.quantity),
                        offerPrice: parseFloat(button.dataset.offerprice),
                        originalPrice: parseFloat(button.dataset.price),
                        discount: parseInt(button.dataset.discount)
                    };
                    
                    updatePriceDisplay(
                        selectedVariant.offerPrice, 
                        selectedVariant.originalPrice, 
                        selectedVariant.discount
                    );
                    
                    const stockInfo = document.getElementById('stock-info');
                    stockInfo.innerHTML = `<span class="text-green-600">${selectedVariant.quantity} pieces in stock</span>`;
                }
            });
            
            variantButtons.forEach((button) => {
                button.addEventListener('click', function() {
                    if (this.disabled) return;
                    
                    variantButtons.forEach(btn => {
                        btn.classList.remove('active', 'border-gray-800', 'bg-gray-800', 'text-white');
                        if (!btn.disabled) {
                            btn.classList.add('border-gray-300', 'bg-white', 'text-gray-800');
                        }
                    });
                    
                    this.classList.remove('border-gray-300', 'bg-white', 'text-gray-800');
                    this.classList.add('active', 'border-gray-800', 'bg-gray-800', 'text-white');
                    
                    selectedVariant = {
                        ml: this.dataset.ml,
                        quantity: parseInt(this.dataset.quantity),
                        offerPrice: parseFloat(this.dataset.offerprice),
                        originalPrice: parseFloat(this.dataset.price),
                        discount: parseInt(this.dataset.discount)
                    };
                    
                    updatePriceDisplay(
                        selectedVariant.offerPrice, 
                        selectedVariant.originalPrice, 
                        selectedVariant.discount
                    );
                    
                    const stockInfo = document.getElementById('stock-info');
                    if (selectedVariant.quantity > 0) {
                        stockInfo.innerHTML = `<span class="text-green-600">${selectedVariant.quantity} pieces in stock</span>`;
                    } else {
                        stockInfo.innerHTML = `<span class="text-red-600">Out of Stock</span>`;
                    }
                    
                    const qtyInput = document.getElementById('quantity');
                    if (parseInt(qtyInput.value) > selectedVariant.quantity) {
                        qtyInput.value = Math.min(selectedVariant.quantity, 10);
                        selectedQuantity = parseInt(qtyInput.value);
                    }
                    
                    updateAddToCartButton();
                });
            });
        }

        async function toggleWishlist() {
            try {
                const wishlistBtn = document.getElementById('wishlist-btn');
                const heartIcon = wishlistBtn.querySelector('i');
                
                const currentWishlist = JSON.parse(localStorage.getItem('userWishlist') || '[]');
                const isCurrentlyInWishlist = currentWishlist.includes(productId);
                
                if (!isCurrentlyInWishlist) {
                    heartIcon.classList.remove('far');
                    heartIcon.classList.add('fas');
                    wishlistBtn.classList.add('text-red-500');
                    
                    const response = await axios.post('/wishlist/add', {
                        productId: productId
                    });
                    
                    if (response.data.success) {
                        currentWishlist.push(productId);
                        localStorage.setItem('userWishlist', JSON.stringify(currentWishlist));
                        
                        window.dispatchEvent(new CustomEvent('wishlistUpdated', {
                            detail: { productId, action: 'added' }
                        }));
                        
                        showAlert.success('Added to wishlist!');
                    } else {
                        heartIcon.classList.remove('fas');
                        heartIcon.classList.add('far');
                        wishlistBtn.classList.remove('text-red-500');
                        showAlert.error(response.data.message || 'Failed to add to wishlist');
                    }
                } else {
                    heartIcon.classList.remove('fas');
                    heartIcon.classList.add('far');
                    wishlistBtn.classList.remove('text-red-500');
                    
                    const response = await axios.delete(`/wishlist/remove/${productId}`);
                    
                    if (response.data.success) {
                        const updatedWishlist = currentWishlist.filter(id => id !== productId);
                        localStorage.setItem('userWishlist', JSON.stringify(updatedWishlist));
                        
                        window.dispatchEvent(new CustomEvent('wishlistUpdated', {
                            detail: { productId, action: 'removed' }
                        }));
                        
                        showAlert.success('Removed from wishlist!');
                    } else {
                        heartIcon.classList.remove('far');
                        heartIcon.classList.add('fas');
                        wishlistBtn.classList.add('text-red-500');
                        showAlert.error(response.data.message || 'Failed to remove from wishlist');
                    }
                }
            } catch (error) {
                console.error('Error updating wishlist:', error);
                
                if (error.response?.status === 401) {
                    showAlert.warning('Please login to manage your wishlist');
                } else {
                    showAlert.error('Error updating wishlist');
                }
                
                const wishlistBtn = document.getElementById('wishlist-btn');
                const heartIcon = wishlistBtn.querySelector('i');
                heartIcon.classList.remove('fas', 'far');
                heartIcon.classList.add('far');
                wishlistBtn.classList.remove('text-red-500');
            }
        }

        async function checkInitialWishlistStatus() {
            try {
                const localWishlist = JSON.parse(localStorage.getItem('userWishlist') || '[]');
                const isInLocalWishlist = localWishlist.includes(productId);
                
                if (isInLocalWishlist) {
                    updateWishlistUI(true);
                }
                
                const response = await axios.get(`/wishlist/check/${productId}`);
                
                if (response.data.success) {
                    const isInWishlist = response.data.inWishlist;
                    updateWishlistUI(isInWishlist);
                    
                    if (isInWishlist && !isInLocalWishlist) {
                        localWishlist.push(productId);
                        localStorage.setItem('userWishlist', JSON.stringify(localWishlist));
                    } else if (!isInWishlist && isInLocalWishlist) {
                        const updatedWishlist = localWishlist.filter(id => id !== productId);
                        localStorage.setItem('userWishlist', JSON.stringify(updatedWishlist));
                    }
                }
            } catch (error) {
                console.error('Error checking wishlist status:', error);
                const localWishlist = JSON.parse(localStorage.getItem('userWishlist') || '[]');
                const isInWishlist = localWishlist.includes(productId);
                updateWishlistUI(isInWishlist);
            }
        }

        function updateWishlistUI(isInWishlist) {
            const wishlistBtn = document.getElementById('wishlist-btn');
            const heartIcon = wishlistBtn.querySelector('i');
            
            if (isInWishlist) {
                heartIcon.classList.remove('far');
                heartIcon.classList.add('fas');
                wishlistBtn.classList.add('text-red-500');
            } else {
                heartIcon.classList.remove('fas');
                heartIcon.classList.add('far');
                wishlistBtn.classList.remove('text-red-500');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initializeVariantSelection();
            updateAddToCartButton();
            checkInitialWishlistStatus();
            
            document.getElementById('wishlist-btn').addEventListener('click', toggleWishlist);
            
            $("#mainImage").elevateZoom({
                zoomType: "lens",
                lensShape: "round",
                lensSize: 200
            });
        });

        async function addToCart(isBuyNow = false) {
    if (!selectedVariant || selectedVariant.quantity <= 0) {
        showAlert.warning('Please select a valid variant');
        return;
    }

    const quantity = parseInt(document.getElementById('quantity').value);
    
    const actionBtn = isBuyNow ? document.getElementById('buy-now-btn') : document.getElementById('add-to-cart-btn');
    const originalText = actionBtn.innerHTML;
    
    actionBtn.innerHTML = '🔄 Processing...';
    actionBtn.disabled = true;

    try {
        const endpoint = isBuyNow ? `/buy-now/${productId}` : `/cart/${productId}`;
        
        const response = await axios.post(endpoint, {
            quantity: quantity,
            variantMl: selectedVariant.ml
        }, {
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        });

        if (response.data.success) {
            if (isBuyNow) {
                showAlert.success('Proceeding to checkout...');
                setTimeout(() => {
                    window.location.href = "/checkout";
                }, 1000);
            } else {
                showAlert.success('Product added to cart!', 1500);
                setTimeout(() => {
                    window.location.href = '/cart';
                }, 1500);
            }
        } else {
            showAlert.info(response.data.message || 'User not found. Please login first.');
            actionBtn.innerHTML = originalText;
            actionBtn.disabled = false;
        }
    } catch (error) {
        actionBtn.innerHTML = originalText;
        actionBtn.disabled = false;
        
        console.error("Error:", error);
        
        if (error.response && error.response.status === 401) {
            showAlert.info(error.response.data.message || 'Please login to add items to cart');
            setTimeout(() => {
                window.location.href = "/login";
            }, 2000);
            return;
        }
        
        if (error.response && error.response.data && error.response.data.message) {
            showAlert.error(error.response.data.message);
        } else {
            showAlert.error("Something went wrong. Please try again.");
        }
    }
}

        async function addRelatedToCart(relatedProductId) {
    const btn = document.querySelector(`[data-product-id="${relatedProductId}"]`);
    const originalText = btn.innerHTML;
    
    btn.innerHTML = '🔄 Adding...';
    btn.disabled = true;

    try {
        const response = await axios.post(`/cart/${relatedProductId}`, {
            quantity: 1
        }, {
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        });

        if (response.data.success) {
            showAlert.success('Product added to cart successfully!', 1500);
            setTimeout(() => {
                window.location.href = '/cart';
            }, 1500);
        } else {
            showAlert.info(response.data.message || 'Failed to add to cart');
            btn.innerHTML = originalText;
            btn.disabled = false;
        }

    } catch (error) {
        btn.innerHTML = originalText;
        btn.disabled = false;
        
        if (error.response && error.response.status === 401) {
            showAlert.info(error.response.data.message || 'Please login to add items to cart');
            setTimeout(() => {
                window.location.href = "/login";
            }, 2000);
            return;
        }
        
        showAlert.error(error.response?.data?.message || 'Network error. Please try again.');
    }
}
    </script>
</body>
