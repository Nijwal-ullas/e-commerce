<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart - Rube Collection</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body {
            font-family: "Lato", sans-serif;
        }
        .product-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
        }
        .quantity-btn {
            width: 32px;
            height: 32px;
            border: 1px solid #d1d5db;
            background: white;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            border-radius: 4px;
        }
        .quantity-btn:hover:not(:disabled) {
            background: #dc2626;
            color: white;
            border-color: #dc2626;
        }
        .quantity-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            background: #f3f4f6;
        }
        .remove-btn:hover svg {
            transform: scale(1.1);
        }
        .stock-warning {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.7; }
            100% { opacity: 1; }
        }
    </style>
</head>

<body class="bg-gray-50">
    <%- include("../partials/user/header.ejs") %>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

        <% if (cartItems && cartItems.length > 0) { %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-8">
                <div class="bg-white rounded-lg shadow-sm">
                    <div class="border-b border-gray-200 px-6 py-4">
                        <h1 class="text-2xl font-semibold text-gray-900">Shopping Cart</h1>
                        <p class="text-sm text-gray-600 mt-1"><%= cartItems.length %> <%= cartItems.length === 1 ? 'item' : 'items' %> in your cart</p>
                    </div>

                    <div class="divide-y divide-gray-200">
                        <% cartItems.forEach(item => { 
                            const product = item.packageProductId;
                            if (!product) return;

                            const variant = product.VariantItem?.find(v => v._id.toString() === item.variantId?.toString());
                            
                            const currentPrice = variant ? (variant.offerPrice || variant.Price) : (item.price || 0);
                            const originalPrice = variant ? variant.Price : currentPrice;
                            const hasDiscount = variant && variant.offerPrice && variant.Price > variant.offerPrice;
                            const discountPercentage = hasDiscount ? 
                                Math.round(((originalPrice - currentPrice) / originalPrice) * 100) : 0;
                            
                            const isBlocked = product.isListed === false;
                            const stock = !isBlocked ? (variant?.Quantity || product.stock || 0) : 0;
                            const isOutOfStock = stock === 0;
                            const exceedsStock = stock > 0 && item.quantity > stock;
                            const itemTotal = currentPrice * item.quantity;

                            const productName = product.productName || "Product";
                            const image = product.images?.[0] || "/images/placeholder.png";
                            const categoryName = product.category?.name || "Uncategorized";
                        %>

                        <div class="p-6 <%= (isOutOfStock || isBlocked) ? 'bg-gray-50' : '' %>">
                            <div class="flex gap-4 sm:gap-6">
                                <div class="flex-shrink-0">
                                    <img src="<%= image %>" 
                                         class="product-image rounded-lg border border-gray-200 <%= (isOutOfStock || isBlocked) ? 'opacity-60' : '' %>" 
                                         onerror="this.src='/images/placeholder.png'" 
                                         alt="<%= productName %>" />
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between gap-4">
                                        <div class="flex-1">
                                            <h3 class="text-base font-medium text-gray-900 mb-1 line-clamp-2"><%= productName %></h3>
                                            
                                            <% if (categoryName && categoryName !== "Uncategorized") { %>
                                                <span class="inline-flex items-center gap-1 text-xs text-gray-600 bg-gray-100 px-2 py-1 rounded">
                                                    <i class="fas fa-tag text-[10px]"></i>
                                                    <%= categoryName %>
                                                </span>
                                            <% } %>

                                            <% if (variant) { %>
                                                <p class="text-sm text-gray-600 mt-2">Size: <span class="font-medium text-gray-900"><%= variant.Ml %>ml</span></p>
                                            <% } else { %>
                                                <p class="text-sm text-red-600 mt-2">Variant no longer available</p>
                                            <% } %>

                                            <div class="mt-3">
                                                <% if (isBlocked) { %>
                                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-700 bg-gray-200 px-3 py-1.5 rounded-full">
                                                        <i class="fas fa-ban text-[10px]"></i>
                                                        UNAVAILABLE
                                                    </span>
                                                <% } else if (isOutOfStock) { %>
                                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-700 bg-red-100 px-3 py-1.5 rounded-full stock-warning">
                                                        <i class="fas fa-exclamation-circle text-[10px]"></i>
                                                        OUT OF STOCK
                                                    </span>
                                                <% } else if (exceedsStock) { %>
                                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-yellow-700 bg-yellow-100 px-3 py-1.5 rounded-full">
                                                        <i class="fas fa-exclamation-triangle text-[10px]"></i>
                                                        Only <%= stock %> available (you have <%= item.quantity %>)
                                                    </span>
                                                <% } else if (stock < 5) { %>
                                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-orange-700 bg-orange-100 px-3 py-1.5 rounded-full">
                                                        <i class="fas fa-clock text-[10px]"></i>
                                                        Only <%= stock %> left
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <button onclick="removeFromCart('<%= item._id %>')" 
                                                class="remove-btn flex-shrink-0 h-8 w-8 flex items-center justify-center text-gray-600 hover:text-red-600 transition-colors duration-200">
                                            <svg class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    </div>

                                    <div class="flex flex-wrap items-center justify-between gap-4 mt-4">
                                        <div class="flex items-center gap-3">
                                            <span class="text-sm text-gray-600">Qty:</span>
                                            <div class="flex items-center gap-2">
                                                <!-- Decrement button - always enabled if quantity > 1 -->
                                                <button class="quantity-btn" 
                                                        onclick="updateQuantity('<%= item._id %>', 'decrement')" 
                                                        <%= item.quantity <= 1 ? 'disabled' : '' %>>
                                                    −
                                                </button>
                                                <span class="w-10 text-center font-medium text-gray-900 <%= exceedsStock ? 'text-yellow-600 font-bold' : '' %>">
                                                    <%= item.quantity %>
                                                </span>
                                                <!-- Increment button - disabled if out of stock or at max -->
                                                <button class="quantity-btn" 
                                                        onclick="updateQuantity('<%= item._id %>', 'increment')" 
                                                        <%= isOutOfStock || item.quantity >= 10 || (stock > 0 && item.quantity >= stock) || isBlocked ? 'disabled' : '' %>>
                                                    +
                                                </button>
                                            </div>
                                        </div>

                                        <div class="text-right">
                                            <% if (hasDiscount) { %>
                                                <div class="flex items-center justify-end gap-2 mb-1">
                                                    <span class="text-xs font-semibold text-green-700 bg-green-100 px-2 py-0.5 rounded">
                                                        <%= discountPercentage %>% OFF
                                                    </span>
                                                </div>
                                            <% } %>
                                            
                                            <div class="flex items-center justify-end gap-2">
                                                <span class="text-sm <%= isOutOfStock || isBlocked ? 'text-gray-400' : 'text-gray-600' %>">₹<%= currentPrice.toFixed(2) %></span>
                                                <% if (hasDiscount) { %>
                                                    <span class="text-sm text-gray-500 line-through">₹<%= originalPrice.toFixed(2) %></span>
                                                <% } %>
                                            </div>
                                            
                                            <% if (item.quantity) { %>
                                                <div class="text-lg font-semibold <%= isOutOfStock || isBlocked ? 'text-gray-400' : 'text-gray-700' %>">
                                                    Total: ₹<%= itemTotal.toFixed(2) %>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>

                    <% if (totalPage > 1) { %>
                    <div class="border-t border-gray-200 px-6 py-4">
                        <div class="flex justify-center items-center gap-2">
                            <% if (page > 1) { %>
                            <a href="/cart?page=<%= page - 1 %>"
                               class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition">
                                Previous
                            </a>
                            <% } %> 
                            
                            <% for (let i = 1; i <= totalPage; i++) { %>
                            <a href="/cart?page=<%= i %>"
                               class="px-4 py-2 text-sm font-medium rounded-md transition <%= i === page ? 'bg-red-600 text-white' : 'text-gray-700 bg-white border border-gray-300 hover:bg-gray-50' %>">
                                <%= i %>
                            </a>
                            <% } %> 
                            
                            <% if (page < totalPage) { %>
                            <a href="/cart?page=<%= page + 1 %>"
                               class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition">
                                Next
                            </a>
                            <% } %>
                        </div>
                    </div>
                    <% } %>

                    <div class="border-t border-gray-200 px-6 py-4">
                        <button onclick="window.location.href='/product'" 
                                class="inline-flex items-center gap-2 text-red-600 hover:text-red-700 font-medium transition">
                            <i class="fas fa-arrow-left"></i>
                            Continue Shopping
                        </button>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-4">
                <div class="bg-white rounded-lg shadow-sm sticky top-4">
                    <div class="border-b border-gray-200 px-6 py-4">
                        <h2 class="text-lg font-semibold text-gray-900">Order Summary</h2>
                    </div>

                    <% 
                        let subtotal = 0;
                        let originalSubtotal = 0;
                        let totalDiscount = 0;
                        let hasOutOfStock = false;
                        let hasBlockedProduct = false;
                        let inStockItems = 0;
                        let outOfStockItems = 0;
                        let blockedItems = 0;
                        
                        cartItems.forEach(item => {
                            const product = item.packageProductId;
                            if (!product) return;
                            
                            const isBlocked = product.isListed === false;
                            const variant = product.VariantItem?.find(v => v._id.toString() === item.variantId?.toString());
                            const stock = !isBlocked ? (variant?.Quantity ||  0) : 0;
                            
                            if (isBlocked) {
                                hasBlockedProduct = true;
                                blockedItems++;
                            } else if (stock <= 0) {
                                hasOutOfStock = true;
                                outOfStockItems++;
                            } else {
                                const currentPrice = variant ? (variant.offerPrice || variant.Price) : (item.price || 0);
                                const originalPrice = variant ? variant.Price : currentPrice;
                                const itemTotal = currentPrice * item.quantity;
                                const itemOriginalTotal = originalPrice * item.quantity;
                                
                                subtotal += itemTotal;
                                originalSubtotal += itemOriginalTotal;
                                totalDiscount += (itemOriginalTotal - itemTotal);
                                inStockItems++;
                            }
                        });
                        
                        const hasOverallDiscount = totalDiscount > 0;
                        const shipping = subtotal >= 500 ? 0 : 50;
                        const total = subtotal + shipping;
                        const canCheckout = !hasOutOfStock && !hasBlockedProduct && inStockItems > 0;
                    %>

                    <div class="px-6 py-4 space-y-3">
                        <!-- Stock Status Summary -->
                        <% if (outOfStockItems > 0 || blockedItems > 0) { %>
                        <div class="mb-3">
                            <% if (outOfStockItems > 0) { %>
                            <div class="flex items-center gap-2 text-sm text-red-600 mb-1">
                                <i class="fas fa-exclamation-circle"></i>
                                <span><%= outOfStockItems %> <%= outOfStockItems === 1 ? 'item' : 'items' %> out of stock</span>
                            </div>
                            <% } %>
                            <% if (blockedItems > 0) { %>
                            <div class="flex items-center gap-2 text-sm text-gray-600">
                                <i class="fas fa-ban"></i>
                                <span><%= blockedItems %> <%= blockedItems === 1 ? 'item' : 'items' %> unavailable</span>
                            </div>
                            <% } %>
                        </div>
                        <% } %>

                        <% if (hasOverallDiscount) { %>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">Original Price</span>
                                <span class="text-gray-500 line-through">₹<%= originalSubtotal.toFixed(2) %></span>
                            </div>
                            
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-600">Discount</span>
                                <span class="text-green-600 font-medium">−₹<%= totalDiscount.toFixed(2) %></span>
                            </div>
                        <% } %>

                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Subtotal (<%= inStockItems %> <%= inStockItems === 1 ? 'item' : 'items' %>)</span>
                            <span class="text-gray-900 font-medium">₹<%= subtotal.toFixed(2) %></span>
                        </div>

                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">Shipping</span>
                            <span class="<%= shipping === 0 ? 'text-green-600 font-medium' : 'text-gray-900 font-medium' %>">
                                <%= shipping === 0 ? "FREE" : "₹" + shipping.toFixed(2) %>
                            </span>
                        </div>

                        <% if (subtotal > 0 && subtotal < 500) { %>
                            <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-xs text-blue-700">
                                <i class="fas fa-truck mr-1"></i>
                                Add <span class="font-semibold">₹<%= (500 - subtotal).toFixed(2) %></span> more for FREE delivery
                            </div>
                        <% } %>

                        <div class="border-t border-gray-200 pt-3 mt-3">
                            <div class="flex justify-between items-center">
                                <span class="text-base font-semibold text-gray-900">Total</span>
                                <span class="text-xl font-bold text-gray-900">₹<%= total.toFixed(2) %></span>
                            </div>
                            
                            <% if (hasOverallDiscount) { %>
                                <div class="text-xs text-green-600 text-right mt-1">
                                    <i class="fas fa-tag mr-1"></i>You save ₹<%= totalDiscount.toFixed(2) %>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <% if (hasBlockedProduct || hasOutOfStock) { %>
                    <div class="px-6 pb-4">
                        <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                            <div class="flex gap-2">
                                <i class="fas fa-exclamation-circle text-red-600 mt-0.5"></i>
                                <div class="text-xs text-red-700">
                                    <% if (hasBlockedProduct && hasOutOfStock) { %>
                                        <p class="font-medium mb-1">Cannot proceed with checkout</p>
                                        <p>Please remove:</p>
                                        <ul class="mt-1 ml-2 list-disc list-inside">
                                            <% if (hasBlockedProduct) { %><li>Unavailable items (<%= blockedItems %>)</li><% } %>
                                            <% if (hasOutOfStock) { %><li>Out of stock items (<%= outOfStockItems %>)</li><% } %>
                                        </ul>
                                    <% } else if (hasBlockedProduct) { %>
                                        <p class="font-medium">Some items are unavailable</p>
                                        <p class="mt-1">Please remove unavailable items to proceed</p>
                                    <% } else if (hasOutOfStock) { %>
                                        <p class="font-medium">Some items are out of stock</p>
                                        <p class="mt-1">Please remove out-of-stock items to proceed</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <div class="border-t border-gray-200 px-6 py-4">
                        <button onclick="proceedToCheckout()" 
                                class="w-full py-3 rounded-lg font-medium transition-colors duration-200 <%= canCheckout ? 'bg-red-600 text-white hover:bg-red-700' : 'bg-gray-300 text-gray-500 cursor-not-allowed' %>"
                                <%= !canCheckout ? 'disabled' : '' %>>
                            <% if (canCheckout) { %>
                                <i class="fas fa-lock mr-2"></i>Proceed to Checkout (<%= inStockItems %> items)
                            <% } else { %>
                                <i class="fas fa-ban mr-2"></i>Cannot Proceed
                            <% } %>
                        </button>
                        
                        <div class="flex items-center justify-center gap-2 mt-3 text-xs text-gray-500">
                            <i class="fas fa-shield-alt"></i>
                            <span>Secure checkout · 100% Safe</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <% } else { %>

        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
            <div class="max-w-md mx-auto">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <i class="fas fa-shopping-cart text-4xl text-gray-400"></i>
                </div>
                <h2 class="text-2xl font-semibold text-gray-900 mb-3">Your cart is empty</h2>
                <p class="text-gray-600 mb-8">Add items to get started</p>
                <a href="/product" class="inline-flex items-center gap-2 bg-red-600 text-white px-8 py-3 rounded-lg hover:bg-red-700 transition font-medium">
                    <i class="fas fa-shopping-bag"></i>
                    Start Shopping
                </a>
            </div>
        </div>

        <% } %>

    </div>

    <%- include("../partials/user/footer.ejs") %>

    <script>
        const showAlert = {
            loading: (message = 'Processing...') => {
                Swal.fire({
                    title: message,
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
            },
            close: () => Swal.close()
        };

        async function updateQuantity(itemId, action) {
            try {
                showAlert.loading('Updating quantity...');
                
                const res = await axios.post("/cart/update-quantity", { itemId, action });
                
                showAlert.close();
                
                if (res.data.success) {
                    window.location.reload();
                } else {
                    let icon = 'error';
                    let title = 'Cannot Update';
                    let showCancelButton = false;
                    let confirmButtonText = 'OK';
                    let cancelButtonText = '';
                    
                    if (res.data.allowDecreaseOnly) {
                        icon = 'warning';
                        title = 'Out of Stock';
                        showCancelButton = true;
                        confirmButtonText = 'Decrease Quantity';
                        cancelButtonText = 'Keep as is';
                    } else if (res.data.stockAvailable) {
                        icon = 'info';
                        title = 'Limited Stock Available';
                    }
                    
                    const result = await Swal.fire({
                        icon: icon,
                        title: title,
                        text: res.data.message,
                        confirmButtonColor: '#dc2626',
                        showCancelButton: showCancelButton,
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: confirmButtonText,
                        cancelButtonText: cancelButtonText
                    });
                    
                    if (result.isConfirmed && res.data.allowDecreaseOnly) {
                        updateQuantity(itemId, 'decrement');
                    } else if (result.isConfirmed && res.data.stockAvailable) {
                        window.location.reload();
                    }
                }
            } catch (error) {
                showAlert.close();
                
                if (error.response?.status === 401) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Login Required',
                        text: 'Please login to update cart',
                        confirmButtonColor: '#dc2626',
                        showCancelButton: true,
                        confirmButtonText: 'Login'
                    }).then((result) => {
                        if (result.isConfirmed) window.location.href = '/login';
                    });
                } else if (error.response?.status === 403) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Product Blocked',
                        text: error.response.data.message,
                        confirmButtonColor: '#dc2626'
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to update quantity',
                        confirmButtonColor: '#dc2626'
                    });
                }
            }
        }

        async function removeFromCart(itemId) {
            const confirm = await Swal.fire({
                title: "Remove item?",
                text: "This item will be removed from your cart",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc2626",
                cancelButtonColor: "#6b7280",
                confirmButtonText: "Yes, remove",
                cancelButtonText: "Cancel"
            });

            if (!confirm.isConfirmed) return;

            try {
                showAlert.loading('Removing item...');
                
                const res = await axios.post(`/cart/remove/${itemId}`);
                
                showAlert.close();
                
                if (res.data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Removed',
                        text: res.data.message,
                        confirmButtonColor: '#dc2626',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: res.data.message,
                        confirmButtonColor: '#dc2626'
                    });
                }
            } catch (error) {
                showAlert.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to remove item',
                    confirmButtonColor: '#dc2626'
                });
            }
        }

        async function proceedToCheckout() {
    try {
        showAlert.loading('Validating cart items...');
        const res = await axios.post("/cart/validate");
        showAlert.close();

        if (res.data.success) {
            window.location.href = "/checkout";
        } else {
            // If validation fails but returns success: false
            Swal.fire({
                icon: "error",
                title: "Cannot Proceed",
                text: res.data.message || "Cart validation failed",
                confirmButtonColor: '#dc2626'
            }).then(() => {
                window.location.reload();
            });
        }
    } catch (error) {
        showAlert.close();
        
        if (error.response) {
            Swal.fire({
                icon: "error",
                title: "Cannot Proceed",
                text: error.response.data?.message || "Cart validation failed",
                confirmButtonColor: '#dc2626'
            }).then(() => {
                if (error.response.status === 400) {
                    window.location.reload();
                }
            });
        } else if (error.request) {
            Swal.fire({
                icon: "error",
                title: "Network Error",
                text: "Please check your internet connection",
                confirmButtonColor: '#dc2626'
            });
        } else {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong",
                confirmButtonColor: '#dc2626'
            });
        }
    }
}

        document.addEventListener('DOMContentLoaded', function() {
            const outOfStockItems = document.querySelectorAll('[class*="OUT OF STOCK"]');
            const unavailableItems = document.querySelectorAll('[class*="UNAVAILABLE"]');
            
            if (outOfStockItems.length > 0 || unavailableItems.length > 0) {
                const notification = document.createElement('div');
                notification.className = 'fixed top-4 right-4 bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-3 rounded-lg shadow-lg z-50 text-sm max-w-md';
                notification.innerHTML = `
                    <div class="flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>
                            <p class="font-medium">Cart needs attention</p>
                            <p class="text-xs mt-1">Some items in your cart are unavailable or out of stock</p>
                        </div>
                    </div>
                `;
                document.body.appendChild(notification);
                
                setTimeout(() => {
                    notification.remove();
                }, 5000);
            }
            
            const buttons = document.querySelectorAll('.quantity-btn, button[onclick*="removeFromCart"]');
            
            buttons.forEach(button => {
                button.addEventListener('click', function(e) {
                    if (!this.disabled) {
                        const originalOnClick = this.getAttribute('onclick');
                        this.removeAttribute('onclick');
                        this.disabled = true;
                        
                        setTimeout(() => {
                            if (this.parentNode) {
                                this.setAttribute('onclick', originalOnClick);
                                this.disabled = false;
                            }
                        }, 1000);
                    }
                });
            });
        });

        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'r') {
                e.preventDefault();
                const confirmRemove = confirm('Remove all invalid items from cart?');
                if (confirmRemove) {
                    window.location.href = '/cart/cleanup';
                }
            }
        });
    </script>
</body>
</html>